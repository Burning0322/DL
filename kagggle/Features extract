    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f\"使用设备: {device}\")\n",
    "\n",
    "# 超参数\n",
    "learning_rate = 0.001\n",
    "epochs = 200\n",
    "batch_size = 64\n",
    "k_folds = 5\n",
    "threshold = 0.7\n",
    "dropout = 0.5\n",
